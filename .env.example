# ─── Database ────────────────────────────────────────────────────────────────
# Neon: use the *pooled* connection string here (port 6543, pgbouncer=true)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech:6543/neondb?pgbouncer=true&connect_timeout=10&pool_timeout=10&connection_limit=1
# Neon: use the *direct* connection string here (port 5432, no pgbouncer)
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech:5432/neondb?connect_timeout=10

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
SESSION_SECRET=replace_with_64_char_random_string_run_openssl_rand_hex_64

# ─── URLs ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins (CORS + OAuth redirect)
CLIENT_URL=https://nextask-flame.vercel.app
# Public URL of this backend — used to construct OAuth callback URLs
SERVER_URL=https://nexttask-backend.onrender.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ─── GitHub API (for issue import) ───────────────────────────────────────────
GITHUB_TOKEN=ghp_replace_with_your_github_pat

# ─── Email (SMTP via Gmail App Password) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=NexTask <your_email@gmail.com>

# ─── AI Scheduler ────────────────────────────────────────────────────────────
AI_ANALYSIS_INTERVAL_MINUTES=360
